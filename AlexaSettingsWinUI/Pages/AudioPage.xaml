<Page
    x:Class="AlexaSettingsWinUI.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Padding="32,24,32,16">
            <TextBlock Text="Аудіо" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Мікрофон, гучність та синтез мови"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="32,0,32,8">
            <StackPanel Spacing="8" MaxWidth="780">

                <!-- Мікрофон -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16" Padding="20,16">
                        <TextBlock Text="Мікрофон" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <ComboBox x:Name="CmbMicrophone" Header="Пристрій введення"
                                  HorizontalAlignment="Stretch"/>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderMicVol" Header="Гучність мікрофону"
                                    Minimum="0" Maximum="100"
                                    ValueChanged="SliderMicVol_ValueChanged"/>
                            <TextBlock x:Name="TxtMicVolVal" Text="100%"
                                       Grid.Column="1" VerticalAlignment="Bottom"
                                       Margin="0,0,0,6" TextAlignment="Center"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- VU-метр -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Тест мікрофону" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="BtnMicTest" Content="▶ Старт" Grid.Column="1"
                                    Click="BtnMicTest_Click"/>
                        </Grid>
                        <ProgressBar x:Name="PbMicLevel" Minimum="0" Maximum="100" Height="8"
                                     CornerRadius="4"/>
                        <TextBlock Text="Говоріть у мікрофон — шкала покаже рівень сигналу"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- TTS -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Синтез мови (TTS)" Style="{StaticResource BodyStrongTextBlockStyle}"
                                       VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="TglTtsEnabled" Grid.Column="1"
                                          OnContent="Увімк." OffContent="Вимк."
                                          Margin="0,-8,0,0"/>
                        </Grid>
                        <ComboBox x:Name="CmbTtsVoice" Header="Голос" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="TxtTtsRate" Header="Швидкість" PlaceholderText="+25%"/>
                    </StackPanel>
                </Border>

                <!-- STT -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Gemini STT" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Використовувати Gemini для розпізнавання мови замість стандартного"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" Margin="0,4,0,0"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="TglGeminiSTT" Grid.Column="1"
                                          OnContent="Gemini" OffContent="Стандарт"
                                          Margin="16,-8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="32,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button x:Name="BtnSave" Content="Зберегти"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="BtnSave_Click"/>
        </Border>
    </Grid>
</Page>
