<Page
    x:Class="AlexaSettingsWinUI.Pages.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Padding="32,24,32,16">
            <TextBlock Text="Плагіни" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock x:Name="TxtPluginsDir"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="32,0,32,8">
            <ItemsControl x:Name="PluginsList" MaxWidth="780"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="32,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button x:Name="BtnSave" Content="Зберегти"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="BtnSave_Click"/>
        </Border>
    </Grid>
</Page>
