<Page
    x:Class="AlexaSettingsWinUI.Pages.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Padding="32,24,32,16">
            <TextBlock Text="Додатково" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Моделі AI та таймаути сесій"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="32,0,32,8">
            <StackPanel Spacing="8" MaxWidth="780">

                <!-- Моделі AI -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16" Padding="20,16">
                        <TextBlock Text="Моделі Gemini" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBox x:Name="TxtRoutingModel"
                                 Header="Routing Model — маршрутизація команд (легка модель)"
                                 PlaceholderText="gemini-2.0-flash-lite"/>
                        <TextBox x:Name="TxtPluginModel"
                                 Header="Plugin Model — виклик плагінів (основна модель)"
                                 PlaceholderText="gemini-2.0-flash"/>
                    </StackPanel>
                </Border>

                <!-- Таймаути -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16" Padding="20,16">
                        <TextBlock Text="Таймаути сесії" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <NumberBox x:Name="NudCommandTimeout"
                                       Header="Тайм-аут сесії (сек)"
                                       Minimum="5" Maximum="120"
                                       SpinButtonPlacementMode="Inline"
                                       Grid.Column="0" Grid.Row="0"/>
                            <NumberBox x:Name="NudContinuousListen"
                                       Header="Безперервне слухання (сек)"
                                       Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Inline"
                                       Grid.Column="1" Grid.Row="0"/>
                            <NumberBox x:Name="NudSilenceDetect"
                                       Header="Виявлення тиші (сек)"
                                       Minimum="0.5" Maximum="10" SmallChange="0.5"
                                       SpinButtonPlacementMode="Inline"
                                       Grid.Column="0" Grid.Row="1"/>
                            <NumberBox x:Name="NudSilenceTimeout"
                                       Header="Тайм-аут тиші (сек)"
                                       Minimum="1" Maximum="30" SmallChange="0.5"
                                       SpinButtonPlacementMode="Inline"
                                       Grid.Column="1" Grid.Row="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="32,12"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Button x:Name="BtnSave" Content="Зберегти"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="BtnSave_Click"/>
        </Border>
    </Grid>
</Page>
